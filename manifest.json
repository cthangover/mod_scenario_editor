{
  "id": "scenario_editor",
  "name": "Scenario Editor",
  "version": "0.1.0",
  "author": "ct",
  "description": "Edit scenario text and transition graphs, then play-test inside the current game.",
  "categories": ["tools", "editor"],
  "sources": [
    "src/**/*.cs"
  ],
  "depends": [
    "tools_base>=0.1.0",
    "scenario_tools_base>=0.1.0",
    "dialog_base>=0.1.0",
    "ui_base>=0.1.0"
  ],
  "test_suites": [
    {
      "id": "ingame_play",
      "activate": [
        "--itest=ingame_play"
      ]
    },
    {
      "id": "new_scenario",
      "activate": [
        "--itest=new_scenario"
      ]
    }
  ]
}
